# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Never commit real credentials)
# For local development:
MONGODB_URI=mongodb://127.0.0.1:27017/finlearn
# Or for MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/finlearn?retryWrites=true&w=majority

# Client CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Future Auth / Secret Configuration (Placeholders for upcoming phases)
# JWT_SECRET=your_jwt_secret_min_32_characters_here
# GEMINI_API_KEY=your_gemini_api_key_backend_only
